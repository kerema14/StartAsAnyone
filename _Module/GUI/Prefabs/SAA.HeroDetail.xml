<Prefab>
	<Constants>
		<!--The tableau camera is a fixed vertical FOV, so the character's on-screen size tracks
        this height and nothing else: widening the panel does not enlarge it, and
        CustomRenderScale only changes the texture resolution. Everything else in the upper
        panel is laid out over the render.-->
		<Constant Name="SAA.Tableau.Height" Value="720" />
	</Constants>
	<Window>
		<!--DataSource: HeroDetailVM-->
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="20">
			<Children>
				<!--Empty state-->
				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="30" MarginRight="30" Brush="Encyclopedia.SubPage.Info.Text" Brush.TextHorizontalAlignment="Center" Text="@EmptyText" IsVisible="@IsEmpty" />
				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@IsEmpty">
					<Children>
						<ListPanel StackLayout.LayoutMethod="HorizontalLeftToRight" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"  >
							<Children>
								<ListPanel Id="HeroCharacterPanel" MarginLeft="20" StackLayout.LayoutMethod="HorizontalLeftToRight" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" >
									<Children>
										<!--3D character-->
										<Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" VerticalAlignment="Top" IsEnabled="true" IsVisible="@HasTableau">
											<Children>
												<Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="300" >
													<Children>
														<EncyclopediaCharacterTableauWidget DataSource="{HeroCharacter}" PositionXOffset="10" MarginRight="35" PositionYOffset="0"  WidthSizePolicy="Fixed"  SuggestedWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center" HeightSizePolicy="StretchToParent" IsEnabled="true" BodyProperties="@BodyProperties" IsFemale="@IsFemale" EquipmentCode="@EquipmentCode" CharStringId="@CharStringId" StanceIndex="@StanceIndex" BannerCodeText="@BannerCodeText" MountCreationKey="@MountCreationKey" IsDead="@IsDead" ArmorColor1="@ArmorColor1" ArmorColor2="@ArmorColor2" IdleAction="@IdleAction" IdleFaceAnim="@IdleFaceAnim" Race="@Race" />
													</Children>
												</Widget>
												
												<ListPanel DataSource="{Traits}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight">
													<ItemTemplate>
														<EncyclopediaHeroTraitVisualWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="58" SuggestedHeight="59" MarginLeft="-6" MarginRight="-6" TraitId="@TraitId" TraitValue="@Value">
															<Children>
																<HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</EncyclopediaHeroTraitVisualWidget>
													</ItemTemplate>
												</ListPanel>
											</Children>
										</Widget>
										
										
										<ListPanel Id="StatChips" VerticalAlignment="Bottom" HorizontalAlignment="Right" MarginBottom="100" MarginLeft="-50" MarginRight="10" StackLayout.LayoutMethod="VerticalTopToBottom" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren">
											<Children>
												<!--Level sits in the corner rather than under the rank: centred, it lands on the
				character's head, because the render starts about a fifth of the way down.-->
												<SAA.StatChip HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="22" MarginRight="32" Parameter.Icon="General\Icons\Level@2x" Parameter.Value="@LevelText" Parameter.IconSize="34" Parameter.FontSize="27" />
												<SAA.StatChip HorizontalAlignment="Left" Parameter.Icon="General\Icons\Coin@2x" Parameter.Value="@GoldText" />
												<Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" IsVisible="@HasClanStats">
													<Children>
														<SAA.StatChip Parameter.Icon="Encyclopedia\star_without_glow" Parameter.Value="@RenownText" />
													</Children>
												</Widget>
												<Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" IsVisible="@HasClanStats">
													<Children>
														<SAA.StatChip Parameter.Icon="General\Icons\Influence@2x" Parameter.Value="@InfluenceText" />
													</Children>
												</Widget>
												<Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" IsVisible="@HasParty">
													<Children>
														<SAA.StatChip Parameter.Icon="General\Icons\Party@2x" Parameter.Value="@PartyText" />
													</Children>
												</Widget>
											</Children>
										</ListPanel>
									</Children>
								</ListPanel>
								<ScrollablePanel Id="HeroScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="30" MarginBottom="15" MarginLeft="28" MarginRight="30" ClipRect="HeroClipRect" InnerPanel="HeroClipRect\HeroList" VerticalScrollbar="..\HeroScrollbar" MouseScrollAxis="Vertical" AutoHideScrollBars="true">
									<Children>
										<Widget Id="HeroClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
											<Children>
												<ListPanel Id="HeroList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
													<Children>
														<ListPanel Id="TableauAndEncyclopedia" StackLayout.LayoutMethod="HorizontalLeftToRight" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
															<Children>
																
																<ListPanel Id="RightPanel" StackLayout.LayoutMethod="VerticalTopToBottom" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
																	<Children>
																		<ListPanel Id="NameTagAndLevel" StackLayout.LayoutMethod="HorizontalLeftToRight" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
																			<Children>
																				<!--Name, rank and level over the tableau-->
																				<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" MarginLeft="20" MarginRight="20" DoNotAcceptEvents="true" StackLayout.LayoutMethod="VerticalTopToBottom">
																					<Children>
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MaxHeight="90" MarginTop="8" Brush="Encyclopedia.SubPage.Title.Text" Brush.FontSize="36" Brush.TextHorizontalAlignment="Center" Text="@NameText" />
																						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Encyclopedia.SubPage.Info.Text" Brush.FontColor="#E1BE8FFF" Brush.TextHorizontalAlignment="Center" Text="@RankText" />
																					</Children>
																				</ListPanel>
																			</Children>
																		</ListPanel>
																		
																		<!--Bio-->
																		<RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" MarginBottom="24" MarginLeft="24" MarginRight="24" Brush="Encyclopedia.SubPage.Info.Text" Text="@InformationText" />
																	</Children>
																</ListPanel>
															</Children>
														</ListPanel>
														
														<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="900" SuggestedHeight="9" HorizontalAlignment="Center" MarginTop="8" DoNotAcceptEvents="true" Sprite="General\CharacterCreation\stone_divider_thin" />
														<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
															<Children>
																
																
																<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" DoNotAcceptEvents="true" Brush="Encyclopedia.Skill.Text" Brush.FontSize="22" Brush.TextHorizontalAlignment="Center" Text="@SkillsText" IsVisible="@HasAnySkills" />
																<GridWidget DataSource="{Skills}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginRight="60" MarginLeft="60" HorizontalAlignment="Center" MarginTop="4" DefaultCellWidth="48" DefaultCellHeight="60" ColumnCount="9" LayoutImp.VerticalLayoutMethod="TopToBottom">
																	<ItemTemplate>
																		<SkillIconVisualWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="3" MarginRight="3" MarginBottom="20" SkillId="@SkillId" UseSmallestVariation="true">
																			<Children>
																				<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="20" ClipContents="false" Brush="Encyclopedia.Skill.Text" Brush.FontSize="20" IntText="@SkillValue" />
																				<HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
																			</Children>
																		</SkillIconVisualWidget>
																	</ItemTemplate>
																</GridWidget>
															</Children>
														</ListPanel>
															
														<!--What is left after the flanking chips: age, clan, culture, spouse.-->
														<ListPanel DataSource="{Stats}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" StackLayout.LayoutMethod="VerticalTopToBottom">
															<ItemTemplate>
																<SAA.StatLine />
															</ItemTemplate>
														</ListPanel>
														<!--Family-->
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="22" Brush="Encyclopedia.Skill.Text" Brush.FontSize="22" Text="@FamilyText" IsVisible="@HasFamily" />
														<NavigatableGridWidget DataSource="{Family}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginTop="8" DefaultCellWidth="100" DefaultCellHeight="110" ColumnCount="5" AutoScrollTopOffset="35" AutoScrollBottomOffset="35">
															<ItemTemplate>
																<SAA.PortraitTile />
															</ItemTemplate>
														</NavigatableGridWidget>
														<!--Fiefs-->
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="22" Brush="Encyclopedia.Skill.Text" Brush.FontSize="22" Text="@FiefsText" IsVisible="@HasFiefs" />
														<NavigatableGridWidget DataSource="{Fiefs}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginTop="8" DefaultCellWidth="100" DefaultCellHeight="140" ColumnCount="5" AutoScrollTopOffset="35" AutoScrollBottomOffset="35">
															<ItemTemplate>
																<ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="90" SuggestedHeight="90" Brush="Encyclopedia.SubPage.Element" Command.Click="ExecuteLink">
																	<Children>
																		<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="@FileName" />
																		<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" PositionYOffset="95" Brush="Encyclopedia.SubPage.Element.Name.Text" Brush.FontSize="18" Text="@NameText" />
																		<HintWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
																	</Children>
																</ButtonWidget>
															</ItemTemplate>
														</NavigatableGridWidget>
														<!--Friends-->
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="22" Brush="Encyclopedia.Skill.Text" Brush.FontSize="22" Text="@FriendsText" IsVisible="@HasFriends" />
														<NavigatableGridWidget DataSource="{Friends}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginTop="8" DefaultCellWidth="100" DefaultCellHeight="110" ColumnCount="5" AutoScrollTopOffset="35" AutoScrollBottomOffset="35">
															<ItemTemplate>
																<SAA.PortraitTile />
															</ItemTemplate>
														</NavigatableGridWidget>
														<!--Rivals-->
														<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="22" Brush="Encyclopedia.Skill.Text" Brush.FontSize="22" Text="@RivalsText" IsVisible="@HasRivals" />
														<NavigatableGridWidget DataSource="{Rivals}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" MarginTop="8" DefaultCellWidth="100" DefaultCellHeight="110" ColumnCount="5" AutoScrollTopOffset="35" AutoScrollBottomOffset="35">
															<ItemTemplate>
																<SAA.PortraitTile />
															</ItemTemplate>
														</NavigatableGridWidget>
													</Children>
												</ListPanel>
											</Children>
										</Widget>
									</Children>
								</ScrollablePanel>
								<ScrollbarWidget Id="HeroScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="10" MarginTop="30" MarginBottom="15" AlignmentAxis="Vertical" Handle="HeroScrollbarHandle" MinValue="0" MaxValue="100">
									<Children>
										<ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed" />
										<ImageWidget Id="HeroScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="50" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle" />
									</Children>
								</ScrollbarWidget>
							</Children>
						</ListPanel>
						<!--Scrolling body-->
					</Children>
				</Widget>
			</Children>
		</Widget>
	</Window>
</Prefab>
