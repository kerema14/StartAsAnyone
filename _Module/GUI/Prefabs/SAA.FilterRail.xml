<Prefab>
  <Window>
    <!--DataSource: CharacterScreenVM-->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!--Search box-->
        <NavigationScopeTargeter ScopeID="SAASearchScope" ScopeParent="..\SearchBox" ScopeMovements="Vertical" NavigateFromScopeEdges="true" />
        <Widget Id="SearchBox" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" VerticalAlignment="Top">
          <Children>
            
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="gradient_texture" MarginTop="10" MarginBottom="10" MarginRight="10"/>
            <EditableTextWidget Id="SearchInput" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Center" MarginLeft="22" MarginRight="52" Brush="Encyclopedia.Search.TextBox" Text="@SearchText" GamepadNavigationIndex="0" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Center" MarginLeft="24" MarginRight="52" DoNotAcceptEvents="true" Brush="Encyclopedia.Search.TextBox" Brush.AlphaFactor="0.45" Text="@SearchPlaceholderText" IsVisible="@IsSearchEmpty" />
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="25" SuggestedHeight="24" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="22" DoNotAcceptEvents="true" Sprite="Encyclopedia\icon_search" />
          </Children>
        </Widget>

        <!--Filter groups-->
        <ScrollablePanel Id="FilterScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="86" MarginBottom="70" MarginRight="16" ClipRect="FilterClipRect" InnerPanel="FilterClipRect\FilterList" VerticalScrollbar="..\FilterScrollbar" MouseScrollAxis="Vertical" AutoHideScrollBars="true">
          <Children>
            <Widget Id="FilterClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
              <Children>
                <ListPanel Id="FilterList" DataSource="{FilterGroups}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="20">
                  <ItemTemplate>
                    <EncyclopediaFilterGroup MarginBottom="26" />
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </ScrollablePanel>

        <ScrollbarWidget Id="FilterScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Center" MarginTop="86" MarginBottom="70" AlignmentAxis="Vertical" Handle="FilterScrollbarHandle" MinValue="0" MaxValue="100">
          <Children>
            <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed" />
            <ImageWidget Id="FilterScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="50" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle" />
          </Children>
        </ScrollbarWidget>

        <!--Reset-->
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46" VerticalAlignment="Bottom" MarginRight="16" Brush="ButtonBrush2" Command.Click="ExecuteResetFilters" IsEnabled="@CanResetFilters" UpdateChildrenStates="true">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="22" Text="@ResetFiltersText" />
          </Children>
        </ButtonWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
